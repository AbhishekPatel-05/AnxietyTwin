# AnxietyTwin Environment Configuration Example
# Copy to .env and replace placeholders with your actual secrets

# Security & Authentication
SECRET_KEY=replace_with_a_secure_random_string_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite for development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anxietytwin

# ML Models Directory
ML_MODELS_DIR=./ml/models

# Server Ports
PORT=8000
FRONTEND_PORT=5173

# ==============================================================================
# AI Assistant & LLM Intelligence Upgrade Configuration
# ==============================================================================
# Provider selection: 'gemini' | 'openai' | 'anthropic' | 'ollama' | 'grounded_clinical'
# If unset or if API keys are missing, AnxietyTwin automatically and safely
# falls back to the deterministic zero-dependency 'grounded_clinical' RAG engine.
AI_ASSISTANT_PROVIDER=grounded_clinical

# Google Gemini Configuration
# GEMINI_API_KEY=your_google_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-pro

# OpenAI Configuration
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local Ollama Configuration (Local / Air-Gapped deployment)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:8b
